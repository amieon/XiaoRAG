# 仅保存非敏感运行配置；账号、密码、令牌不得写入此文件或 Git。
# PGVECTOR_DSN、MILVUS_TOKEN 含数据库凭证，只能在当前终端环境变量或权限受限的本地 .env 中设置。
# MILVUS_URI 可设服务端 URI 或本地 Milvus Lite 文件路径；本地路径不含凭证。
PADDLEOCR_VLM_DEVICE=gpu:0
PADDLEOCR_LAYOUT_DEVICE=gpu:0
PADDLEOCR_DEVICE=gpu:0
PADDLEOCR_LAYOUT_ENGINE=paddle_dynamic
PADDLEOCR_VLM_ENGINE=paddle_dynamic
PADDLEOCR_ENGINE=paddle_static
PADDLEOCR_LANG=ch
PADDLEOCR_REC_BATCH=6
# 使用 CUDA_VISIBLE_DEVICES 时，如逻辑编号与 nvidia-smi 物理编号不同，请显式设置：
# PADDLEOCR_GPU_MEMORY_DEVICE=0

# 零样本标题模型：OpenAI 兼容服务地址和模型名不是密钥。
HEADING_MODEL_BASE_URL=http://127.0.0.1:8000/v1
HEADING_MODEL_NAME=your-model-name
# HEADING_MODEL_API_KEY 只在当前终端或权限 600 的本地 .env 设置，不写入示例、脚本或 Git。
